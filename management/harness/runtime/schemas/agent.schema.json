{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "agent_id",
    "name",
    "description",
    "jurisdiction",
    "use_cases",
    "prohibited_actions",
    "inputs",
    "outputs",
    "handoff_requirements",
    "tools",
    "required_when",
    "domains",
    "registration_revision",
    "mandatory",
    "phase",
    "mandatory_run"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z]{2,5}-[0-9]{2,}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "use_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "handoff_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "required_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "registration_revision": {
      "type": "integer",
      "minimum": 1
    },
    "mandatory": {
      "type": "boolean"
    },
    "phase": {
      "enum": [
        "coordinator",
        "specialist",
        "research",
        "audit",
        "documentation",
        "collection"
      ]
    },
    "mandatory_run": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}

; First spatial qualification harness. Open with Godot .NET 4.7.1.
config_version=5

[application]
config/name="SCP — Spatial Prototype"
run/max_fps=60
run/main_scene="res://Scenes/SpatialScene.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="SiteScene"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.059, 1)
